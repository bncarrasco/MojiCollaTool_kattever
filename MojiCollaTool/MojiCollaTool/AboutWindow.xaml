<Window x:Class="MojiCollaTool.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MojiCollaTool 勝手版について"
        Width="520"
        SizeToContent="Height"
        MinHeight="300"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="MojiCollaTool 勝手版" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,4,0,16"/>
        <TextBlock x:Name="ForkNoticeText" Grid.Row="2" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="3" Margin="0,6,0,0" Text="公式版および原作者とは無関係です。" TextWrapping="Wrap"/>
        <TextBlock x:Name="ContactNoticeText" Grid.Row="4" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="5" Margin="0,16,0,0" Text="著作権表示とMIT License: LICENSE&#x0a;第三者ライセンス: THIRD-PARTY-NOTICES.md" TextWrapping="Wrap"/>
        <Button Grid.Row="6" Width="90" Margin="0,20,0,0" HorizontalAlignment="Right" Content="閉じる" IsDefault="True" Click="CloseButton_Click"/>
    </Grid>
</Window>
