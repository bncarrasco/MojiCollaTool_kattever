<UserControl x:Class="MojiCollaTool.PageEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MojiCollaTool"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="CanvasGrid" Grid.Row="0" Grid.Column="0" Background="Gray"
              AllowDrop="True" Drop="CanvasGrid_Drop" DragOver="CanvasGrid_DragOver"
              PreviewMouseWheel="CanvasGrid_PreviewMouseWheel">
            <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                <Canvas x:Name="MainCanvas" Background="Gray">
                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1"/>
                    </Canvas.LayoutTransform>
                    <Canvas.CacheMode>
                        <BitmapCache EnableClearType="True" RenderAtScale="1" SnapsToDevicePixels="False"/>
                    </Canvas.CacheMode>
                    <Rectangle x:Name="CanvasBackgroundRect"/>
                    <Image x:Name="ImageControl1"/>
                    <Image x:Name="ImageControl2"/>
                </Canvas>
            </ScrollViewer>
        </Grid>
        <GroupBox Header="文字リスト" Grid.Row="0" Grid.Column="1">
            <ListView x:Name="MojiListView" HorizontalContentAlignment="Stretch"
                      SelectionChanged="MojiListView_SelectionChanged"
                      PreviewMouseLeftButtonUp="MojiListView_PreviewMouseLeftButtonUp">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="5">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ID:"/>
                                    <TextBlock Text="{Binding Id}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ExampleText}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="5">
            <Label Content="拡大・縮小:" VerticalAlignment="Center"/>
            <local:UpDownTextBox x:Name="ScalingTextBox" ValueMinLimit="10" Step="10"
                                 ValueChanged="ScalingTextBox_ValueChanged"/>
            <Label Content="%" VerticalAlignment="Center"/>
            <ComboBox x:Name="BalloonShapeComboBox" Width="120" Margin="18,0,4,0"
                      SelectedIndex="0" VerticalAlignment="Center">
                <ComboBoxItem Content="楕円" Tag="Ellipse"/>
                <ComboBoxItem Content="角丸四角" Tag="RoundedRectangle"/>
                <ComboBoxItem Content="四角" Tag="Rectangle"/>
                <ComboBoxItem Content="モノローグ" Tag="Monologue"/>
            </ComboBox>
            <Button x:Name="AddBalloonButton" Content="フキダシ追加" Click="AddBalloonButton_Click"
                    Margin="4,0,0,0" Padding="8,2"/>
        </StackPanel>
        <Button x:Name="CanvasEditButton" Grid.Row="1" Grid.Column="1" Margin="5"
                Click="CanvasEditButton_Click">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Image Source="/Images/canvas.png" Margin="5"/>
                <TextBlock VerticalAlignment="Center">
                    キャンバスを<LineBreak/>
                    設定する
                </TextBlock>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
